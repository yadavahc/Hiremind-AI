# ============================================================================
# HireMind AI — Environment variables
# Copy this file to `.env` and fill in values. The app runs fully WITHOUT any
# keys (the AI Recruiter falls back to a local engine) — keys only unlock the
# Gemini-powered natural-language features.
# ============================================================================

# Google Gemini 2.5 Flash — powers the AI Recruiter chat + richer explanations.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hugging Face token — used by the Python ranker (scripts/rank.py) to download
# BAAI/bge-large-en-v1.5 and the cross-encoder. Not needed by the web app.
HF_TOKEN=

# SQLite database (Prisma). Optional persistence layer for uploaded JDs + chat.
DATABASE_URL="file:./dev.db"
